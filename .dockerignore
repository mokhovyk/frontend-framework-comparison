# Host-installed dependencies and build outputs must not overwrite the
# container's own (native modules like better-sqlite3 are platform-specific).
**/node_modules
**/dist
**/.angular
**/.vite
**/*.tsbuildinfo

# Results are mounted as a volume at runtime
results

# Not needed in the image
.git
.github
**/test-results
**/playwright-report
.DS_Store
